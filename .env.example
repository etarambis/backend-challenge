# Application
PORT=3000
NODE_ENV=development

# PostgreSQL (used by the API and docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=challenge_cursor

# PokeAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# TypeORM migrations (schema changes via migrations only; synchronize is always false)
# RUN_MIGRATIONS=true

# Seeds (npm run seed:run) only run when NODE_ENV is development, dev, or local.
# In production the CLI exits with an error and seed SQL is skipped.
